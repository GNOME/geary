#: desktop/geary-attach.contract.desktop.in:2
msgid "Send by email"
msgstr "Send på e-post"

#: desktop/geary-attach.contract.desktop.in:5
msgid "Send files using Geary"
msgstr "Send filer med Geary"

#. Translators: The application name
#: desktop/geary-autostart.desktop.in.in:2
#: desktop/org.gnome.Geary.desktop.in.in:2
#: desktop/org.gnome.Geary.metainfo.xml.in.in:11
#: src/client/accounts/accounts-editor-servers-pane.vala:551
#: src/client/application/application-main-window.vala:710
msgid "Geary"
msgstr "Geary"

#: desktop/geary-autostart.desktop.in.in:3
#: desktop/org.gnome.Geary.desktop.in.in:3
msgid "Email"
msgstr "E-post"

#. Translators: The application's summary / tagline
#: desktop/geary-autostart.desktop.in.in:4
#: desktop/org.gnome.Geary.desktop.in.in:4
#: desktop/org.gnome.Geary.metainfo.xml.in.in:15
#: src/client/application/application-client.vala:18
msgid "Send and receive email"
msgstr "Send og ta imot e-post"

#. Translators: These are desktop search terms. Do not translate semicolons, end line with a semicolon.
#: desktop/geary-autostart.desktop.in.in:6
msgid "Email;E-mail;Mail;"
msgstr "E-post;Mail;"

#. Translators: These are desktop search terms. Do not translate semicolons, end line with a semicolon.
#: desktop/org.gnome.Geary.desktop.in.in:6
msgid "Mail;E-mail;email;IMAP;GMail;Yahoo;Hotmail;Outlook;"
msgstr "Mail;E-post;IMAP;GMail;Yahoo;Hotmail;Outlook;"

#: desktop/org.gnome.Geary.desktop.in.in:23
msgid "Compose Message"
msgstr "Skriv ny melding"

#: desktop/org.gnome.Geary.desktop.in.in:27
msgid "New Window"
msgstr "Nytt vindauge"

#: desktop/org.gnome.Geary.gschema.xml:8
msgid "Maximize window"
msgstr "Maksimer vindauget"

#: desktop/org.gnome.Geary.gschema.xml:9
msgid "True if the application window is maximized, false otherwise."
msgstr "Sann viss programvindauget er maksimert, usann elles."

#: desktop/org.gnome.Geary.gschema.xml:14
msgid "Width of window"
msgstr "Breidd på vindauget"

#: desktop/org.gnome.Geary.gschema.xml:15
msgid "The last recorded width of the application window."
msgstr "Den siste registrerte breidda til programvindauget."

#: desktop/org.gnome.Geary.gschema.xml:20
msgid "Height of window"
msgstr "Høgd på vindauget"

#: desktop/org.gnome.Geary.gschema.xml:21
msgid "The last recorded height of the application window."
msgstr "Den siste registrerte høgda til programvindauget."

#: desktop/org.gnome.Geary.gschema.xml:26
msgid "Show/hide formatting toolbar"
msgstr "Vis/gøym formateringsverktøylinja"

#: desktop/org.gnome.Geary.gschema.xml:27
msgid "True if the formatting toolbar in the composer is shown."
msgstr "Sann viss formateringsverktøylinja i skriveområdet er synleg."

#: desktop/org.gnome.Geary.gschema.xml:32
msgid "Autoselect next message"
msgstr "Vel neste melding automatisk"

#: desktop/org.gnome.Geary.gschema.xml:33
msgid "True if we should autoselect the next available conversation."
msgstr "Sann viss neste tilgjengelege samtale skal veljast automatisk."

#: desktop/org.gnome.Geary.gschema.xml:38
msgid "Display message previews"
msgstr "Vis førehandsvising av meldingar"

#: desktop/org.gnome.Geary.gschema.xml:39
msgid "True if we should display a short preview of each message."
msgstr "Sann viss vi skal vise ei kort førehandsvising av kvar melding."

#: desktop/org.gnome.Geary.gschema.xml:44
msgid "Override colors in HTML emails"
msgstr "Overstyr fargar i HTML-meldingar"

#: desktop/org.gnome.Geary.gschema.xml:45
msgid ""
"Overrides the original colors in HTML messages to integrate better with the "
"app theme."
msgstr ""
"Overstyrer dei opphavlege fargane i HTML-meldingar slik at dei passar betre "
"med tema til programmet."

#: desktop/org.gnome.Geary.gschema.xml:50
msgid "Move messages by default"
msgstr "Flytt meldingar som standard"

#: desktop/org.gnome.Geary.gschema.xml:51
msgid "When tagging a message, move it to destination folder."
msgstr "Når du merkar ei melding, flytt henne til målmappa."

#: desktop/org.gnome.Geary.gschema.xml:56
msgid "Use single key shortcuts"
msgstr "Bruk snarvegar med éin tast"

#: desktop/org.gnome.Geary.gschema.xml:57
msgid ""
"Enables shortcuts for email actions that do not require pressing <Ctrl> to "
"emulate those used by Gmail."
msgstr ""
"Slår på snarvegar for e-posthandlingar som ikkje krev <Ctrl>, for å "
"etterlikne dei som Gmail brukar."

#: desktop/org.gnome.Geary.gschema.xml:64
msgid "Languages that shall be used in the spell checker"
msgstr "Språk som skal brukast i stavekontrollen"

#: desktop/org.gnome.Geary.gschema.xml:65
msgid ""
"A list of POSIX locales, with the empty list disabling spell checking and "
"the null list using desktop languages by default."
msgstr ""
"Ei liste over POSIX-lokalitetar. Ei tom liste slår av stavekontroll, og "
"ingen verdi (null) brukar skrivebordsspråka som standard."

#: desktop/org.gnome.Geary.gschema.xml:72
msgid "Languages that are displayed in the spell checker popover"
msgstr "Språk som vert viste i stavekontrollmenyen"

#: desktop/org.gnome.Geary.gschema.xml:73
msgid ""
"List of languages that are always displayed in the popover of the spell "
"checker."
msgstr "Liste over språk som alltid vert viste i stavekontrollmenyen."

#: desktop/org.gnome.Geary.gschema.xml:78
msgid "Run application in background on logon and when closed"
msgstr "Køyr programmet i bakgrunnen ved innlogging og når det er lukka"

#: desktop/org.gnome.Geary.gschema.xml:79
msgid "True to run application in background."
msgstr "Sann for å køyre programmet i bakgrunnen."

#: desktop/org.gnome.Geary.gschema.xml:84
msgid "Ask when opening an attachment"
msgstr "Spør når eit vedlegg vert opna"

#: desktop/org.gnome.Geary.gschema.xml:85
msgid "True to ask when opening an attachment."
msgstr "Sann for å spørje når eit vedlegg vert opna."

#: desktop/org.gnome.Geary.gschema.xml:90
msgid "Whether to compose emails in HTML"
msgstr "Om e-postar skal skrivast i HTML"

#: desktop/org.gnome.Geary.gschema.xml:91
msgid "True to compose emails in HTML; false for plain text."
msgstr "Sann for å skrive e-postar i HTML; usann for rein tekst."

#: desktop/org.gnome.Geary.gschema.xml:96
msgid "Advisory strategy for full-text searching"
msgstr "Strategi for fulltekstsøk"

#: desktop/org.gnome.Geary.gschema.xml:97
msgid ""
"Acceptable values are “exact”, “conservative”, “aggressive”, and “horizon”."
msgstr ""
"Gyldige verdiar er «exact», «conservative», «aggressive» og «horizon»."

#: desktop/org.gnome.Geary.gschema.xml:102
msgid "Zoom of conversation viewer"
msgstr "Zoom i samtalevisinga"

#: desktop/org.gnome.Geary.gschema.xml:103
msgid "The zoom to apply on the conservation view."
msgstr "Zoom-nivået som skal brukast i samtalevisinga."

#: desktop/org.gnome.Geary.gschema.xml:108
msgid "Size of detached composer window"
msgstr "Storleik på det frigjorde skrivevindauget"

#: desktop/org.gnome.Geary.gschema.xml:109
msgid "The last recorded size of the detached composer window."
msgstr "Den siste registrerte storleiken på det frigjorde skrivevindauget."

#: desktop/org.gnome.Geary.gschema.xml:114
msgid "Allow images for these domains"
msgstr "Tillat bilete frå desse domena"

#: desktop/org.gnome.Geary.gschema.xml:115
msgid "Images from these domains will be trusted"
msgstr "Bilete frå desse domena vert rekna som klarerte"

#: desktop/org.gnome.Geary.gschema.xml:120
msgid "Undo sending email delay"
msgstr "Utsett sending av e-post (angrefrist)"

#: desktop/org.gnome.Geary.gschema.xml:121
msgid ""
"The number of seconds to wait before sending an email. Set to zero or less "
"to disable."
msgstr ""
"Talet på sekund å vente før ein e-post vert sendt. Set til null eller lågare"
" for å slå av."

#: desktop/org.gnome.Geary.gschema.xml:127
msgid "Brief notification display time"
msgstr "Visingstid for korte varsel"

#: desktop/org.gnome.Geary.gschema.xml:128
msgid ""
"The length of time in seconds for which brief notifications should be "
"displayed."
msgstr "Kor mange sekund korte varsel skal visast."

#: desktop/org.gnome.Geary.gschema.xml:134
msgid "List of optional plugins"
msgstr "Liste over valfrie tillegg"

#: desktop/org.gnome.Geary.gschema.xml:135
msgid "Plugins listed here will be loaded on startup."
msgstr "Tillegg som er lista her, vert lasta ved oppstart."

#: desktop/org.gnome.Geary.gschema.xml:140
msgid "Whether we migrated the old settings"
msgstr "Om dei gamle innstillingane er flytta"

#: desktop/org.gnome.Geary.gschema.xml:141
msgid ""
"False to check for the old “org.yorba.geary”-schema and copy its values."
msgstr ""
"Usann for å sjå etter det gamle «org.yorba.geary»-skjemaet og kopiere "
"verdiane derfrå."

#. Translators: The development team's name
#: desktop/org.gnome.Geary.metainfo.xml.in.in:13
msgid "Geary Development Team"
msgstr "Geary-utviklingslaget"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:17
msgid ""
"Geary is an email application built around conversations, for the GNOME "
"desktop. It allows you to read, find and send email with a straightforward, "
"modern interface."
msgstr ""
"Geary er eit e-postprogram bygd rundt samtalar, for GNOME-skrivebordet. Det "
"lèt deg lese, finne og sende e-post med eit enkelt, moderne grensesnitt."

#: desktop/org.gnome.Geary.metainfo.xml.in.in:22
msgid ""
"Conversations allow you to read a complete discussion without having to find "
"and click from message to message."
msgstr ""
"Med samtalar kan du lese ein heil diskusjon utan å måtte lete og klikke deg "
"frå melding til melding."

#: desktop/org.gnome.Geary.metainfo.xml.in.in:26
msgid "Geary’s features include:"
msgstr "Funksjonane i Geary omfattar:"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:28
msgid "Quick email account setup"
msgstr "Rask oppsett av e-postkonto"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:29
msgid "Shows related messages together in conversations"
msgstr "Viser relaterte meldingar saman i samtalar"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:30
msgid "Fast, full text and keyword search"
msgstr "Rask fulltekst- og nøkkelordsøk"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:31
msgid "Full-featured HTML and plain text message composer"
msgstr "Fullverdig meldingsredigering i HTML og ren tekst"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:32
msgid "Desktop notification of new mail"
msgstr "Skrivebordsvarsel om ny e-post"

#: desktop/org.gnome.Geary.metainfo.xml.in.in:33
msgid "Compatible with GMail, Yahoo! Mail, Outlook.com and other IMAP servers"
msgstr "Fungerer med Gmail, Yahoo! Mail, Outlook.com og andre IMAP-tenarar"

#. Translators: A screenshot description.
#: desktop/org.gnome.Geary.metainfo.xml.in.in:50
msgid "Geary displaying a conversation"
msgstr "Geary viser ein samtale"

#. Translators: A screenshot description.
#: desktop/org.gnome.Geary.metainfo.xml.in.in:55
msgid "Geary showing the rich text composer"
msgstr "Geary viser skrivefeltet med rik tekst"

